{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pokko",
  "version": "1.0.0",
  "identifier": "io.github.browzomje.pokko",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/npm-clean.mjs dev",
    "beforeBuildCommand": "node scripts/npm-clean.mjs build"
  },
  "app": {
    "windows": [
      {
        "title": "pokko",
        "width": 1360,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Ricerca manga e download organizzati per volume",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "browzomje",
    "copyright": "Copyright © 2026 browzomje",
    "license": "MIT"
  }
}
