{
  "id": "mangatown",
  "name": "MangaTown",
  "base_url": "https://www.mangatown.com",
  "category": "manga",
  "language": "en",
  "adapter": "generic",
  "enabled": true,
  "min_delay_ms": 1000,
  "note": "Catalogo manga classico in lingua inglese (FMHY)",
  "search_path": "/search?name={query}&page={page}",
  "result_selector": ".manga_pic_list li .title a, .manga_list li .title a",
  "chapter_selector": "ul.chapter_list li a",
  "image_selector": "img#image, #viewer img",
  "description_selector": ".detail_content .content",
  "reader_next_selector": "a.next_page:not([href^='/manga/'])",
  "next_selector": "a.next"
}
