{
  "id": "mw",
  "name": "MangaWorld",
  "base_url": "https://www.mangaworld.mx",
  "category": "manga",
  "language": "it",
  "adapter": "generic",
  "enabled": true,
  "min_delay_ms": 1000,
  "note": "Catalogo manga italiano con gruppi volumi e capitoli",
  "search_path": "/archive?keyword={query}&page={page}",
  "result_selector": "a.manga-title",
  "chapter_selector": "a.chap",
  "image_selector": "img.page-image",
  "description_selector": "#noidungm",
  "next_selector": "a[rel=next], .pagination .next a, a.next",
  "chapter_url_suffix": "?style=list",
  "volume_selector": ".volume-element",
  "volume_title_selector": ".volume-name",
  "chapter_title_selector": "span"
}
