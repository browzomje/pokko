{
  "id": "mangadex",
  "name": "MangaDex",
  "version": "1.0.0",
  "base_url": "https://mangadex.org",
  "category": "manga",
  "language": "both",
  "adapter": "mangadex",
  "min_delay_ms": 500,
  "note": "API ufficiale MangaDex con supporto multilingua e MangaDex@Home",
  "search_path": "/search?keyword={query}&page={page}",
  "result_selector": ".manga-title, .post-title a, .manga-name a",
  "chapter_selector": "a.chap, a.chapter-link, .wp-manga-chapter a",
  "image_selector": "img.page-image, .reading-content img, #readerarea img",
  "description_selector": "#noidungm, .description-summary, .summary__content",
  "next_selector": "a[rel=next], .pagination .next a",
  "enabled": false
}
